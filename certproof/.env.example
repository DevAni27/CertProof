# Copy to .env (optional). Every value below is the default; no secrets are needed.
# Where projects, uploads, PDFs and the SQLite file live (relative paths are resolved from where you start the app)
BATCHPROOF_DATA_DIR=./data
BATCHPROOF_HOST=127.0.0.1
BATCHPROOF_PORT=8000
# Local Ollama (never sent from the browser; the backend calls it)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT_S=240
# How long Ollama keeps the model in memory after the last request (the UI also has an "Unload model" button)
OLLAMA_KEEP_ALIVE=2m
# Limits
MAX_UPLOAD_MB=15
MAX_IMAGE_PIXELS=25000000
MAX_PDF_PAGES=300
MAX_ROWS=1000
MAX_BLANK_COPIES=100
# Optional: path to a specific Chromium/Chrome executable (normally leave unset after `playwright install chromium`)
# BATCHPROOF_CHROMIUM_PATH=
